root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.{bat,ps1}]
end_of_line = crlf

[*.{md,markdown}]
trim_trailing_whitespace = false
# Docs use ASCII hyphen (-), never em dash (U+2014) or en dash (U+2013).
# Keeps byte-exact edits (search/replace) reliable across editors and agents.
