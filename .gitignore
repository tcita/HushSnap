# PyInstaller build artifacts
build/
dist/
*.spec
!HushSnap.spec
__pycache__/

# Test-only native crash trigger (built locally by native/build_crashlib.bat;
# never shipped, never committed — crashlib is a standalone diagnostic tool,
# not bundled by the .spec). MSVC link artifacts land in assets/ during build.
assets/crashlib.*
vc140.pdb

# Installer build artifacts
dist-installer/
dist-installer-dev/
dist-installer-test/

# Executables
*.exe

# IDE / Editor
.vscode/
.vs/
.claude/
.antigravitycli/

# Tool output / profiling data
scratch/

# Stress-test generated artifacts (logs, OCR result variants)
stress_results/
ocr_stability_results/

# Test cache
.pytest_cache/

# Orphaned build links
*.lnk

# OCR batch test images (drop zone for ad-hoc OCR runs)
ocr_batch/*
!ocr_batch/*.py

# Minimal OpenCV build artifacts (scripts/build_minimal_opencv.ps1).
# opencv-work/ = cloned opencv source + cmake/ninja build tree (~500MB+,
#   fully rebuildable by the script).  minimal-cv2-build/ = the staged output
#   cv2.pyd (rebuildable).  Both are build outputs, not source.
scripts/opencv-work/
scripts/minimal-cv2-build/

