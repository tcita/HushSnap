# PyInstaller build artifacts
build/
!scripts/build/
dist/
*.spec

# Clean build venv created by installer/build_msix.ps1 (isolated from dev
# site-packages so pollution never ships). Recreated fresh each build.
.venv-build/
.pip-cache/
# Temp venvs created by ad-hoc scripts/tests
tmport*/
!HushSnap.spec
__pycache__/

# Test-only native crash trigger (built locally by native/build_crashlib.bat;
# never shipped, never committed — crashlib is a standalone diagnostic tool,
# not bundled by the .spec). MSVC link artifacts land in assets/ during build.
assets/crashlib.*
vc140.pdb

# Installer build artifacts
dist-installer/
dist-installer-dev/
dist-installer-test/

# Executables
*.exe

# IDE / Editor
.vscode/
.vs/
.claude/
.antigravitycli/

# Tool output / profiling data
scratch/

# Stress-test generated artifacts (logs, OCR result variants)
stress_results/
ocr_stability_results/

# Test cache
.pytest_cache/

# Orphaned build links
*.lnk

# OCR batch test images (drop zone for ad-hoc OCR runs)
ocr_batch/*
!ocr_batch/*.py

# Minimal OpenCV build artifacts (scripts/build/build_minimal_opencv.ps1).
# opencv-build/ lives at the repo root (not under scripts/, to keep the
# scripts folder clean).  src/ = cloned opencv source, cmake/ = the
# cmake/ninja build tree (~500MB+, fully rebuildable), output/ = the staged
# cv2.pyd.  All build outputs, not source.
/opencv-build/

